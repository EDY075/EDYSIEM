# EDY SIEM local persistence
EDYSIEM_DB=edysiem.db

# EDY Shield -> EDY SIEM machine-to-machine ingestion
# Generate at least 32 random bytes; never commit the real value.
EDYSIEM_SHIELD_INGEST_TOKEN=replace-with-at-least-32-random-bytes

# Optional short rotation window. Remove after all Shield agents use the current token.
# EDYSIEM_SHIELD_INGEST_PREVIOUS_TOKEN=replace-with-previous-token-during-rotation
