# EDY SIEM local persistence
EDYSIEM_DB=edysiem.db
# Optional dedicated append-only audit database (default: edysiem.audit.db).
# EDYSIEM_AUDIT_DB=edysiem.audit.db

# Operator API authentication (required for every protected route).
# Generate a random value with at least 32 bytes. The placeholder is rejected.
EDYSIEM_API_KEY=replace-with-a-random-secret-of-at-least-32-bytes
EDYSIEM_API_IDENTITY=local-operator
# Explicit role: viewer, analyst or admin. Never inferred from request headers.
EDYSIEM_API_ROLE=analyst

# EDY Shield -> EDY SIEM machine-to-machine ingestion
# Generate at least 32 random bytes; never commit the real value.
EDYSIEM_SHIELD_INGEST_TOKEN=replace-with-at-least-32-random-bytes

# Optional short rotation window. Remove after all Shield agents use the current token.
# EDYSIEM_SHIELD_INGEST_PREVIOUS_TOKEN=replace-with-previous-token-during-rotation
